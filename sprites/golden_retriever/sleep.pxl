; Rescaled from the 64x64 drawing (sprites/golden_retriever/64/) to the 48x48 dog size with
; pixelkit.rescale --to 48 --phase 2,0 (drops 1 row/col in 4, outlines stay 1 px), then checked by hand.
name golden_retriever_sleep
size 48 48
scale 2
outline K A
layout
down_left_0 down_left_1
left_0 left_1
right_0 right_1
down_right_0 down_right_1
palette
K #24140c outline
A #3d2314 far-side outline (legs and tail behind the body)
B #1e1618 nose
C #8a5226 fur shade: ears, inside of legs, under the tail
D #d9707f tongue
E #b0743a fur base (gold)
F #d09c5e fur light: brows, paws
G #ecd3a2 cream: muzzle, chest ruff, feathering
H #f6eedf eye glint

frame down_left_0
