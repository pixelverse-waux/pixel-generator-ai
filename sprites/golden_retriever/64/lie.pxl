; Golden retriever lie, drawn by hand from "input/golden_retriever.webp".
; Poses follow refs/local/dog_ref/lie.pxl; head, ears, ruff and plume tail match sprites/golden_retriever.pxl.
name golden_retriever_lie
size 64 64
scale 2
outline K A
layout
left_0 left_1 left_2 left_3 left_4 left_5
right_0 right_1 right_2 right_3 right_4 right_5
palette
K #24140c outline
A #3d2314 far-side outline (legs and tail behind the body)
B #1e1618 nose
C #8a5226 fur shade: ears, inside of legs, under the tail
D #d9707f tongue
E #b0743a fur base (gold)
F #d09c5e fur light: brows, paws
G #ecd3a2 cream: muzzle, chest ruff, feathering
H #f6eedf eye glint

