; Golden retriever pant, drawn by hand from "input/golden_retriever.webp".
; Poses follow refs/local/dog_ref/pant.pxl; head, ears, ruff and plume tail match sprites/golden_retriever.pxl.
name golden_retriever_pant
size 64 64
scale 2
outline K A
layout
sit_0 sit_1 sit_2
stand_0 stand_1 stand_2
palette
K #24140c outline
A #3d2314 far-side outline (legs and tail behind the body)
B #1e1618 nose
C #8a5226 fur shade: ears, inside of legs, under the tail
D #d9707f tongue
E #b0743a fur base (gold)
F #d09c5e fur light: brows, paws
G #ecd3a2 cream: muzzle, chest ruff, feathering
H #f6eedf eye glint

